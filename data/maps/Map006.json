bIt has to battle for it to grow."]],[0,0,[]]]},{"cond":{"s1":80,"s2":0,"v":0,"vv":0,"self":null},"gfx":{"name":"NPC_ProfOak","hue":0,"dir":2,"pattern":0,"opacity":255,"blend":0,"tile":0},"moveType":0,"moveSpeed":3,"moveFreq":3,"route":{"repeat":true,"skippable":false,"list":[]},"walkAnime":true,"stepAnime":false,"dirFix":false,"through":false,"onTop":false,"trigger":0,"list":[[101,0,["\\bOak: Oh, \\PN!\\nHow is my old Pokémon?"]],[101,0,["\\bWell, it seems to be growing more attached to you."]],[101,0,["\\bYou must be talented as a Pokémon Trainer."]],[111,0,[12,"$bag.has?(:OAKSPARCEL)"]],[101,1,["\\bWhat's that?\\nYou have something for me?"]],[355,1,["$bag.remove(:OAKSPARCEL)"]],[101,1,["\\PN delivered Oak's Parcel."]],[121,1,[81,81,0]],[101,1,["\\bAh!\\nIt's the custom Poké Ball!"]],[101,1,["\\bI had it on order.\\nThank you!"]],[247,1,[]],[241,1,[{"name":"Rival","volume":100,"pitch":100}]],[355,1,["pbSetSelfSwitch(26, \"A\", true)"]],[101,1,["\\b\\v[12]: Gramps!"]],[209,1,[26,{"repeat":false,"skippable":false,"list":[[37,[]],[4,[]],[4,[]],[4,[]],[4,[]],[4,[]],[4,[]],[4,[]],[38,[]]]}]],[210,1,[]],[242,1,[1]],[248,1,[]],[101,1,["\\b\\v[12]: I almost forgot!\\nWhat did you call me for?"]],[106,1,[30]],[101,1,["\\bOak: Oh, right!\\nI have a request for you two."]],[209,1,[0,{"repeat":false,"skippable":true,"list":[[4,[]],[2,[]],[4,[]],[16,[]]]}]],[210,1,[]],[101,1,["\\bOn the desk there is my invention, the Pokédex!"]],[101,1,["\\bIt automatically records data on Pokémon you've "]],[401,1,["seen or caught."]],[101,1,["\\bIt's a high-tech encyclopedia!"]],[101,1,["\\bOak: \\PN and \\v[12].\\nTake these with you."]],[355,1,["pbSetSelfSwitch(22, \"A\", true)"]],[106,1,[4]],[355,1,["pbSetSelfSwitch(23, \"A\", true)"]],[106,1,[15]],[209,1,[0,{"repeat":false,"skippable":true,"list":[[3,[]],[10,[]],[10,[]]]}]],[210,1,[]],[355,1,["$player.has_pokedex = true"]],[101,1,["\\bOak: You can't get detailed data on Pokémon by just "]],[401,1,["seeing them."]],[101,1,["\\bYou must 